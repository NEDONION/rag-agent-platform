# ================================
# RAG Agent Platform - 环境变量配置
# ================================

# ================================
# 服务端口配置
# ================================
SERVER_PORT=8088
FRONTEND_PORT=3000

# ================================
# 数据库配置 (阿里云 RDS PostgreSQL)
# ================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ================================
# RabbitMQ 配置
# ================================
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ================================
# S3 对象存储配置 (七牛云 KODO)
# ================================
S3_SECRET_ID=your_qiniu_access_key
S3_SECRET_KEY=your_qiniu_secret_key
S3_REGION=cn-south-1
S3_ENDPOINT=https://s3.cn-south-1.qiniucs.com
S3_BUCKET_NAME=your-bucket-name
S3_DOMAIN=https://your-bucket-name.s3.cn-south-1.qiniucs.com/

# ================================
# AI 模型配置 (硅基流动)
# ================================
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_API_URL_RERANK=https://api.siliconflow.com/v1/rerank
SILICONFLOW_MODEL_RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# LLM 调用超时（秒）。非流式用于意图识别/语义改写/查询扩展等同步小请求，流式用于对话补全。
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=300

# ================================
# CI/CD 自托管 Runner（仅部署机器需要）
# ================================
# 项目在服务器上的绝对路径。必须与实际路径一致——runner 容器要按同样的路径挂载，
# 否则 compose 解析出来的相对路径会指向错误位置。
DEPLOY_PATH=/root/rag-agent-platform

# 细粒度 PAT，权限只需该仓库的 Administration: Read and write（用于注册 runner）
GITHUB_PAT=
GITHUB_REPO=NEDONION/rag-agent-platform
RUNNER_NAME=aliyun-lightweight

# 由 CI 部署时自动写入，记录当前线上运行的 commit。手动部署可留空（回落到 latest）
IMAGE_TAG=

# ================================
# 服务商配置加密密钥（必填）
# ================================
# 用于加密存库的模型服务商 API Key。缺失时后端启动即失败，不提供默认值。
# 生成：openssl rand -base64 32
#
# ⚠️ 更换此密钥会导致已存的服务商配置无法解密，用户需重新填写 API Key。
CONFIG_ENCRYPTION_KEY=

# ================================
# 邮件服务配置 (SMTP)
# ================================
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your_email@qq.com
MAIL_SMTP_PASSWORD=your_email_authorization_code

# ================================
# 前端环境变量（重要：必须配置为浏览器可访问的地址）
# ================================
# 本地开发直连后端（避免跨域配置冲突）
NEXT_PUBLIC_API_URL=http://localhost:8088/api
NEXT_PUBLIC_WS_URL=ws://localhost:8088/api

# ================================
# JVM 配置 (可选)
# ================================
JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200
